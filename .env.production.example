# Example production env for the librarian container.
# Copy to .env.production (gitignored) and fill in real values.
# docker-compose.prod.yml loads this via `env_file: .env.production`.

# --- Postgres (books table + pgvector) ---
# Host is reached from inside the container; on ms-01 the DB runs on the host,
# so use host.docker.internal.
LIBRARIAN_DB_URL=postgresql://USER:PASSWORD@host.docker.internal:5432/librarian

# Data root inside the container (the compose bind-mount maps the deploy host's
# data dir, e.g. /srv/librarian/data, to this path). Sources AND extracted
# artifacts must live under here on the deploy host — see Data locality below.
LIBRARIAN_DATA_ROOT=/data/librarian

# Public URL agents use to reach this MCP server.
LIBRARIAN_PUBLIC_URL=http://ms-01.local:8811

# --- Extraction services (REQUIRED for extract_book) ---
# Without these the container silently skips Marker/GROBID and extracts nothing.
# Both run on the DGX Spark; deployed from the sibling marker-service /
# grobid-service repos.
LIBRARIAN_SPARK_URL=http://spark-f80b.local:8001   # Marker (POST /marker/upload)
GROBID_BASE_URL=http://spark-f80b.local:8070        # GROBID (/api/processFulltextDocument)

# --- Modal (optional; legacy cloud extraction) ---
MODAL_TOKEN_ID=ak-...
MODAL_TOKEN_SECRET=as-...

# --- Data locality (not a variable; a rule) ---
# The extract -> index pipeline runs inside the container and reads/writes
# LIBRARIAN_DATA_ROOT. For the library to be portable, source files and
# extracted artifacts must live on the deploy host (ms-01), NOT on a dev
# machine. A book whose artifacts only exist on a laptop cannot be re-indexed
# in production.
